<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:paddingBottom="4dp" />

    <TextView android:id="@+id/item0" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="14sp" android:paddingTop="6dp" android:paddingBottom="6dp" />
    <TextView android:id="@+id/item1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="14sp" android:paddingTop="6dp" android:paddingBottom="6dp" />
    <TextView android:id="@+id/item2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="14sp" android:paddingTop="6dp" android:paddingBottom="6dp" />
    <TextView android:id="@+id/item3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="14sp" android:paddingTop="6dp" android:paddingBottom="6dp" />
    <TextView android:id="@+id/item4" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="14sp" android:paddingTop="6dp" android:paddingBottom="6dp" />
</LinearLayout>
